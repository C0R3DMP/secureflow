# SecureFlow Configuration

# MCP Security
MCP_SECRET=your-secure-random-token-here

# OpenCode Configuration
OPENCODE_URL=http://localhost:4096

# LLM Configuration
# Analyst Agent: Uses Claude Code CLI (claude command) - no API key needed
# Recon Agent: Uses Gemini (requires API key)
# Reporter Agent: Uses Ollama local (no API key needed)

GEMINI_API_KEY=

# Ollama Configuration (local LLM fallback for Recon)
OLLAMA_BASE_URL=http://localhost:11434

# Debug Logging
LITELLM_DEBUG=false

# Optional: Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
