# SecureFlow Configuration

# MCP Security — bearer token required on all /api, /stream and MCP routes.
# Generate with: openssl rand -hex 32
# If left empty, the server generates an ephemeral token at startup and prints
# it. Set SECUREFLOW_ALLOW_ANONYMOUS=1 to run with no auth (local dev only).
MCP_SECRET=your-secure-random-token-here

# Network binding. Defaults to loopback; only expose deliberately.
SECUREFLOW_HOST=127.0.0.1
SECUREFLOW_PORT=5000

# LLM Provider Configuration (in priority order)
# Choose at least ONE provider to enable the system

# Option 1: Gemini API (PRIMARY - 5 req/min free tier)
# Sign up: https://ai.google.dev/
GEMINI_API_KEY=

# Option 2: OpenRouter (FREE models - no rate limits for free tier)
# Sign up: https://openrouter.ai/
# Free models: google/gemini-2.0-flash-exp:free, meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=

# Option 3: Ollama (LOCAL - free, no API key needed)
# Install: https://ollama.ai
# Then: ollama run qwen2.5-coder
OLLAMA_BASE_URL=http://localhost:11434

# Option 4: Claude API (ALTERNATIVE)
# Sign up: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenCode Configuration (optional, auto-starts with SecureFlow)
OPENCODE_URL=http://localhost:4096
OPENCODE_SERVER_PASSWORD=secureflow

# Debug Logging
LITELLM_DEBUG=false

# Optional: Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
